<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Aba Vendedor: operações no topo e tabela de vendedores embaixo -->
<BorderPane styleClass="tela" stylesheets="@estilo.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.projeto_final_lp2.controller.VendedoresController">

   <top>
      <HBox styleClass="barra-botoes">
         <children>
            <Button onAction="#onVoltar" styleClass="botao-barra, botao-voltar" text="← Menu" />
            <Button onAction="#onCadastrar" styleClass="botao-barra" text="Cadastrar" />
            <Button onAction="#onAtualizar" styleClass="botao-barra" text="Atualizar" />
         </children>
      </HBox>
   </top>

   <center>
      <VBox styleClass="area-tabela">
         <children>
            <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colId" text="ID" />
                  <TableColumn fx:id="colNome" text="Nome" />
                  <TableColumn fx:id="colTelefone" text="Telefone" />
                  <TableColumn fx:id="colDataNasc" text="Data de Nascimento" />
                  <TableColumn fx:id="colSalario" text="Salário Base" />
                  <TableColumn fx:id="colPercentual" text="Comissão (%)" />
                  <TableColumn fx:id="colComissao" text="Total de Comissão" />
               </columns>
            </TableView>
            <Label fx:id="lblStatus" styleClass="rotulo-status" />
         </children>
      </VBox>
   </center>
</BorderPane>
