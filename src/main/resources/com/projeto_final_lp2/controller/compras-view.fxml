<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Aba Compras: notas fiscais de entrada de mercadoria (operações no topo, tabela embaixo) -->
<BorderPane styleClass="tela" stylesheets="@estilo.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.projeto_final_lp2.controller.ComprasController">

   <top>
      <HBox styleClass="barra-botoes">
         <children>
            <Button onAction="#onVoltar" styleClass="botao-barra, botao-voltar" text="← Menu" />
            <Button onAction="#onNovaCompra" styleClass="botao-barra" text="Nova Compra" />
            <Button onAction="#onVerItens" styleClass="botao-barra" text="Ver Itens" />
            <Button onAction="#onAtualizar" styleClass="botao-barra" text="Atualizar" />
         </children>
      </HBox>
   </top>

   <center>
      <VBox styleClass="area-tabela">
         <children>
            <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colId" text="ID da Nota" />
                  <TableColumn fx:id="colNumero" text="Número" />
                  <TableColumn fx:id="colChave" text="Chave de Acesso" />
                  <TableColumn fx:id="colFornecedor" text="Fornecedor" />
                  <TableColumn fx:id="colData" text="Data de Entrada" />
                  <TableColumn fx:id="colTotal" text="Valor Total" />
               </columns>
            </TableView>
            <Label fx:id="lblStatus" styleClass="rotulo-status" />
         </children>
      </VBox>
   </center>
</BorderPane>
