<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Aba Produtos: botoes de operacao no topo (a esquerda) e a tabela de produtos embaixo -->
<BorderPane styleClass="tela" stylesheets="@estilo.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.projeto_final_lp2.controller.ProdutosController">

   <top>
      <HBox styleClass="barra-botoes">
         <children>
            <Button onAction="#onVoltar" styleClass="botao-barra, botao-voltar" text="← Menu" />
            <Button onAction="#onCadastrar" styleClass="botao-barra" text="Cadastrar" />
            <Button onAction="#onEditar" styleClass="botao-barra" text="Editar" />
            <Button onAction="#onExcluir" styleClass="botao-barra" text="Excluir" />
            <Button onAction="#onEstoqueMinimo" styleClass="botao-barra" text="Estoque Mínimo" />
            <Button onAction="#onAtualizar" styleClass="botao-barra" text="Atualizar" />
         </children>
      </HBox>
   </top>

   <center>
      <VBox styleClass="area-tabela">
         <children>
            <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colId" maxWidth="90.0" minWidth="55.0" prefWidth="65.0" text="ID" />
                  <TableColumn fx:id="colNome" text="Produto" />
                  <TableColumn fx:id="colMarca" text="Marca" />
                  <TableColumn fx:id="colSetor" text="Setor" />
                  <TableColumn fx:id="colValor" text="Valor" />
                  <TableColumn fx:id="colQuantidade" text="Quantidade" />
                  <TableColumn fx:id="colQuantidadeMinima" text="Qtd. Mínima" />
                  <TableColumn fx:id="colUltimaCompra" text="Última Compra" />
               </columns>
            </TableView>
            <Label fx:id="lblStatus" styleClass="rotulo-status" />
         </children>
      </VBox>
   </center>
</BorderPane>
