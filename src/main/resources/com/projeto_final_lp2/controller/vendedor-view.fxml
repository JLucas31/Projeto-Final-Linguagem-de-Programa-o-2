<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1050.0" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.projeto_final_lp2.controller.VendedorViewController">
   
   <!-- CABEÇALHO -->
   <top>
      <VBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="3.0" style="-fx-background-color: #0f172a; -fx-padding: 12 25;" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="Área do Vendedor" textFill="#38bdf8">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label text="— Catálogo e Cadastro de Produtos" textFill="WHITE">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Label text="Loja Gamer &amp; Geek - Painel de Controle de Produtos e Estoque" textFill="#94a3b8">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>

   <!-- CONTEÚDO PRINCIPAL: DIVIDIDO EM FORMULÁRIO (ESQUERDA) E TABELA (DIREITA) -->
   <center>
      <HBox spacing="20.0" style="-fx-padding: 20;" BorderPane.alignment="CENTER">
         <children>
            
            <!-- PAINEL ESQUERDO: FORMULÁRIO DE PRODUTO -->
            <VBox maxWidth="420.0" minWidth="380.0" prefWidth="400.0" spacing="15.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label fx:id="lblFormTitulo" text="Cadastrar Novo Produto" textFill="#1e293b">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblProdutoId" style="-fx-background-color: #e0f2fe; -fx-text-fill: #0369a1; -fx-padding: 2 6; -fx-background-radius: 4;" text="ID: " visible="false">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  
                  <Label text="Preencha as informações do produto. (*) Campos obrigatórios." textFill="#64748b">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  
                  <GridPane hgap="10.0" vgap="12.0">
                    <columnConstraints>
                      <ColumnConstraints halignment="RIGHT" minWidth="100.0" prefWidth="110.0" />
                      <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="250.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="35.0" />
                      <RowConstraints minHeight="35.0" />
                      <RowConstraints minHeight="35.0" />
                      <RowConstraints minHeight="35.0" />
                      <RowConstraints minHeight="35.0" />
                    </rowConstraints>
                     <children>
                        <Label text="Nome: *" textFill="#334155">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtNomeProduto" prefHeight="35.0" promptText="Ex: Console PlayStation 5" style="-fx-background-radius: 5;" GridPane.columnIndex="1" />
                        
                        <Label text="Marca:" textFill="#334155" GridPane.rowIndex="1">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtMarca" prefHeight="35.0" promptText="Ex: Sony, Razer, Nintendo" style="-fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label text="Setor: *" textFill="#334155" GridPane.rowIndex="2">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="cbSetor" editable="true" maxWidth="1.7976931348623157E308" prefHeight="35.0" promptText="Selecione ou digite o setor" style="-fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        
                        <Label text="Preço (R$): *" textFill="#334155" GridPane.rowIndex="3">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtValor" prefHeight="35.0" promptText="Ex: 3499.90" style="-fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        
                        <Label text="Quantidade: *" textFill="#334155" GridPane.rowIndex="4">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtQuantidade" prefHeight="35.0" promptText="Ex: 10" style="-fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                     </children>
                  </GridPane>
                  
                  <!-- BOTÕES DE AÇÃO DO FORMULÁRIO -->
                  <VBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                     <children>
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnCadastrar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCadastrarProduto" prefHeight="38.0" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="➕ Cadastrar Produto" HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#onLimpar" prefHeight="38.0" prefWidth="85.0" style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Limpar" />
                           </children>
                        </HBox>
                        
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnAtualizar" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAtualizarProduto" prefHeight="34.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="✏ Atualizar Selecionado" HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnExcluir" disable="true" mnemonicParsing="false" onAction="#onExcluirProduto" prefHeight="34.0" prefWidth="85.0" style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="🗑 Excluir" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <!-- Dica de uso -->
                  <Label text="💡 Dica: Clique em um produto da tabela ao lado para editar ou excluir." textFill="#64748b" wrapText="true">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            
            <!-- PAINEL DIREITO: TABELA DE PRODUTOS E BUSCAS -->
            <VBox spacing="12.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
               <children>
                  
                  <!-- BARRA DE PESQUISA E FILTROS -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="txtPesquisa" prefHeight="35.0" promptText="Pesquisar por nome do produto..." style="-fx-background-radius: 5;" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onPesquisar" prefHeight="35.0" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="🔍 Pesquisar" />
                        <Button mnemonicParsing="false" onAction="#onRecarregarTabela" prefHeight="35.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="🔄 Todos" />
                        <Button mnemonicParsing="false" onAction="#onListarEstoqueBaixo" prefHeight="35.0" style="-fx-background-color: #fef3c7; -fx-text-fill: #b45309; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="⚠️ Estoque Baixo (≤5)" />
                     </children>
                  </HBox>
                  
                  <!-- TABELA DE PRODUTOS -->
                  <TableView fx:id="tabelaProdutos" prefHeight="450.0" style="-fx-background-radius: 5;" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                      <TableColumn fx:id="colNome" prefWidth="180.0" text="Nome do Produto" />
                      <TableColumn fx:id="colMarca" prefWidth="110.0" text="Marca" />
                      <TableColumn fx:id="colSetor" prefWidth="110.0" text="Setor" />
                      <TableColumn fx:id="colValor" prefWidth="95.0" text="Preço Unitário" />
                      <TableColumn fx:id="colQuantidade" prefWidth="75.0" text="Estoque" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  
                  <!-- BARRA DE STATUS INFERIOR DA TABELA -->
                  <Label fx:id="lblStatus" text="Carregando produtos..." textFill="#475569">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>

   <!-- RODAPÉ -->
   <bottom>
      <HBox alignment="CENTER_LEFT" prefHeight="28.0" spacing="10.0" style="-fx-background-color: #e2e8f0; -fx-padding: 0 20;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Módulo do Vendedor | Gerenciamento de Estoque Conectado ao MySQL" textFill="#64748b">
               <font>
                  <Font size="11.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </bottom>

</BorderPane>
