<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Aba Cotação: produtos que chegaram na quantidade mínima (a quantidade a comprar só é definida aqui) -->
<BorderPane styleClass="tela" stylesheets="@estilo.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.projeto_final_lp2.controller.CotacoesController">

   <top>
      <HBox styleClass="barra-botoes">
         <children>
            <Button onAction="#onVoltar" styleClass="botao-barra, botao-voltar" text="← Menu" />
            <Button onAction="#onDefinirQuantidade" styleClass="botao-barra" text="Definir Quantidade" />
            <Button onAction="#onMarcarComprado" styleClass="botao-barra" text="Marcar como Comprado" />
            <Button onAction="#onMarcarPendente" styleClass="botao-barra" text="Voltar a Pendente" />
            <Button onAction="#onRemover" styleClass="botao-barra" text="Remover" />
            <Button onAction="#onAtualizar" styleClass="botao-barra" text="Atualizar" />
         </children>
      </HBox>
   </top>

   <center>
      <VBox styleClass="area-tabela">
         <children>
            <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colId" text="ID Cotação" />
                  <TableColumn fx:id="colData" text="Data da Cotação" />
                  <TableColumn fx:id="colProdutoId" text="ID Produto" />
                  <TableColumn fx:id="colNome" text="Produto" />
                  <TableColumn fx:id="colQuantidade" text="Quantidade da Cotação" />
                  <TableColumn fx:id="colStatus" text="Status" />
               </columns>
            </TableView>
            <Label fx:id="lblStatus" styleClass="rotulo-status" />
         </children>
      </VBox>
   </center>
</BorderPane>
